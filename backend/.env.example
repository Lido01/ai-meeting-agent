# Copy this file to .env and fill in real values before running the backend.

# PostgreSQL connection string (matches docker-compose.yml defaults below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_agent

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Google Gemini API key, used for transcription, meeting analysis,
# and the Context Continuity comparison.
GEMINI_API_KEY=your-gemini-api-key-here
